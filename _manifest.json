{
  "manifest_version": 2,
  "id": "org.orge-8.budget-pacer",
  "version": "1.0.4",
  "name": "月度预算发言频率调节",
  "description": "设定一个月度 API 预算，按「花费进度 ÷ 时间进度」的节奏比动态调节麦麦的发言频率，让整月花费贴近预算。支持全局预算与单会话例外额度。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/budget-pacer",
    "issues": "https://github.com/orge-8/budget-pacer/issues"
  },
  "host_application": {
    "min_version": "1.0.9",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "statistics.local.model_trend",
    "frequency.set_adjust",
    "chat.get_all_streams",
    "database.query"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
